{
  "$schema": "shinobi-character-db/1",
  "note": "Data-driven character definitions. The renderer assembles every entry from the layer stack in layers.js — stage supplies the animation atlas, everything else is an overlay. Adding a character here needs no code change.",
  "layerOrder": [
    "base", "clan", "hair", "eyes", "headband", "outfit", "armor", "weapon",
    "accessory", "injury", "dojutsu", "aura", "transformation", "summon", "jinchuriki"
  ],
  "fields": {
    "stage": "animation atlas: newborn|toddler|child|academy|genin|teen|adult|veteran|elder",
    "clan": "overlay identity: uchiha|hyuga|uzumaki|senju|nara|common",
    "hair": "css colour for the hair recolour layer",
    "eyes": "normal|sharingan|mangekyo|eternal|byakugan|rinnegan",
    "outfit": "css colour for the robe tint layer",
    "armor": "dark|light|leaf|flak|robe|null",
    "weapon": "kunai|shuriken|katana|tanto|naginata|scythe|bow|warfan|scroll|chain",
    "headband": "true when the forehead protector is worn",
    "aura": "Fire|Water|Wind|Earth|Lightning|Wood|Ice|Lava|Shadow|Healing|Beast",
    "voice": "sfx voice set used for effort/hurt cues",
    "idle": "idle animation variant preferred by this character",
    "jutsu": "favourite technique, used for the jutsu effect colour + sound"
  },
  "voices": {
    "child-light":  { "pitch": 1.35, "grain": 0.10 },
    "youth-light":  { "pitch": 1.18, "grain": 0.14 },
    "youth-firm":   { "pitch": 1.06, "grain": 0.20 },
    "adult-calm":   { "pitch": 0.98, "grain": 0.16 },
    "adult-rough":  { "pitch": 0.88, "grain": 0.30 },
    "elder-worn":   { "pitch": 0.80, "grain": 0.38 }
